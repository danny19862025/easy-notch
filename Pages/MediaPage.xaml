<UserControl x:Class="EasyNotch.Pages.MediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource Faint}"/>
            <TextBlock Text="Nothing's playing" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Play music or a video in any app and it'll show up here." FontSize="13"
                       Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid x:Name="Body" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource FieldBg}">
                    <Grid>
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Faint}" Text="&#xE8D6;"/>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="Art" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Title" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="Artist" FontSize="14" Foreground="{StaticResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Pos" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Margin="4,0"
                        PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                <TextBlock x:Name="Left" Grid.Column="2" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Button x:Name="ShuffleBtn" Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Width="40" Height="40" FontSize="16"
                        Content="&#xE8B1;" ToolTip="Shuffle" Click="Shuffle_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Width="44" Height="44" FontSize="20" Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="52" Height="52" FontSize="28" Margin="18,0" Content="&#xE768;" Click="Play_Click"/>
                    <Button Style="{StaticResource IconBtn}" Width="44" Height="44" FontSize="20" Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
                </StackPanel>
                <Button x:Name="RepeatBtn" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Width="40" Height="40" FontSize="16"
                        Content="&#xE8EE;" ToolTip="Repeat" Click="Repeat_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
