<UserControl x:Class="EasyNotch.Pages.NotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- List of note cards -->
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="38" Height="38" Margin="8,0,0,0"
                        Content="&#xE710;" FontSize="15" ToolTip="New note" Click="New_Click"/>
                <TextBox x:Name="Search" Style="{StaticResource Field}" Tag="Search" TextChanged="Search_Changed"/>
            </DockPanel>
            <TextBlock x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource Sub}" TextAlignment="Center"
                       Text="No notes yet. Press + to start one.&#10;Lines starting with [ ] become a checklist."/>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Cards" Orientation="Horizontal" Margin="0,0,0,6"/>
            </ScrollViewer>
        </Grid>

        <!-- Editor -->
        <Grid x:Name="Editor" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Content="&#xE72B;" ToolTip="Back to all notes" Click="Back_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Delete note" Click="Delete_Click"/>
                <Button x:Name="PinBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE718;" Click="Pin_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE73A;" ToolTip="Add a checklist item" Click="Check_Click"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource BareField}" FontSize="17" FontWeight="Bold" Tag="Title"
                         VerticalAlignment="Center" Margin="8,0" TextChanged="Editor_Changed"/>
            </DockPanel>
            <TextBox x:Name="BodyBox" Grid.Row="1" Style="{StaticResource BareField}" FontSize="14" Margin="10,8,0,0"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Tag="Write something… ([ ] makes a checkbox)" TextChanged="Editor_Changed"/>
        </Grid>
    </Grid>
</UserControl>
