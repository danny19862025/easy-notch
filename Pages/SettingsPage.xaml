<UserControl x:Class="EasyNotch.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: widgets -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Pages" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Widgets" Margin="0,0,6,0"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: places + general -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Clock places" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,0,0,6"/>
                <StackPanel x:Name="Places"/>
                <TextBox x:Name="PlaceSearch" Style="{StaticResource Field}" FontSize="13" Padding="10,6" Tag="Add a city or time zone"
                         Margin="0,4,0,0" TextChanged="PlaceSearch_Changed"/>
                <StackPanel x:Name="PlaceHits" Margin="0,2,0,0"/>

                <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,14,0,8"/>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="UnitC" Style="{StaticResource PillBtn}" Content="°C" Padding="12,4" Click="UnitC_Click"/>
                        <Button x:Name="UnitF" Style="{StaticResource PillBtn}" Content="°F" Padding="12,4" Margin="4,0,0,0" Click="UnitF_Click"/>
                    </StackPanel>
                    <TextBlock Text="Temperature" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <CheckBox x:Name="Startup" Content="Start with Windows" Margin="0,0,0,10" Click="Startup_Click"/>
                <CheckBox x:Name="Tuck" Content="Tuck away over full-screen apps" Margin="0,0,0,10" Click="Tuck_Click"/>
                <CheckBox x:Name="Magnet" Content="Hide when a window covers it" Margin="0,0,0,10" Click="Magnet_Click"
                          ToolTip="Move the mouse to the top edge to pull it back out"/>
                <CheckBox x:Name="AutoUpdate" Content="Check for updates automatically" Margin="0,0,0,12" Click="AutoUpdate_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PillBtn}" Content="Data folder" Click="Data_Click"/>
                    <Button Style="{StaticResource PillBtn}" Content="Quit Easy Notch" Margin="8,0,0,0" Click="Quit_Click"/>
                </StackPanel>
                <TextBlock Text="Notes, clipboard and settings stay on this PC, in that folder." FontSize="11"
                           Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
