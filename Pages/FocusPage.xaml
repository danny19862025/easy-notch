<UserControl x:Class="EasyNotch.Pages.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Noise picker -->
        <Button x:Name="NoiseBtn" Style="{StaticResource TextBtn}" HorizontalAlignment="Center" Click="Noise_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Noise: " FontSize="14" Foreground="{StaticResource Sub}"/>
                <TextBlock x:Name="NoiseText" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="6,2,0,0"/>
            </StackPanel>
        </Button>

        <!-- Middle: minutes picker when idle, countdown when running -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid x:Name="Picker">
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Margin="60,0,0,0" Width="40" Height="40" FontSize="15"
                        Content="&#xE738;" ToolTip="5 minutes less" Click="Minus_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="Minutes" FontFamily="{StaticResource Display}" FontSize="72" FontWeight="Light"
                               Typography.NumeralAlignment="Tabular" Margin="0,-10,0,-10"/>
                    <TextBlock Text="min" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Sub}"
                               VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Margin="0,0,60,0" Width="40" Height="40" FontSize="15"
                        Content="&#xE710;" ToolTip="5 minutes more" Click="Plus_Click"/>
            </Grid>
            <StackPanel x:Name="Running" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="Phase" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Focus}"/>
                <TextBlock x:Name="Countdown" FontFamily="{StaticResource Display}" FontSize="64" FontWeight="Light"
                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,-6,0,-8"/>
            </StackPanel>
        </Grid>

        <!-- Bottom row -->
        <Grid Grid.Row="2">
            <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Left" Content="&#xE713;" FontSize="15" ToolTip="Settings" Click="Settings_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PomodoroBtn" Style="{StaticResource TextBtn}" Content="Pomodoro" ToolTip="Focus, then a break, repeating" Click="Pomodoro_Click"/>
                <Button x:Name="ZenBtn" Style="{StaticResource TextBtn}" Content="Zen" Margin="4,0,0,0" ToolTip="One focus session, no breaks" Click="Zen_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StopBtn" Style="{StaticResource IconBtn}" Width="40" Height="40" FontSize="15" Content="&#xE71A;"
                        ToolTip="Stop" Margin="0,0,4,0" Click="Stop_Click"/>
                <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Width="44" Height="44" FontSize="26" Content="&#xE768;" Click="Play_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
