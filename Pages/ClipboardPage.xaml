<UserControl x:Class="EasyNotch.Pages.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="PauseBtn" Style="{StaticResource IconBtn}" Width="36" Height="36" FontSize="15" Click="Pause_Click"/>
                <Button Style="{StaticResource IconBtn}" Width="36" Height="36" FontSize="15" Content="&#xE74D;"
                        ToolTip="Clear everything except pinned items" Click="Clear_Click"/>
                <Button Style="{StaticResource IconBtn}" Width="36" Height="36" FontSize="15" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
            </StackPanel>
            <TextBox x:Name="Search" Style="{StaticResource Field}" Tag="Search" TextChanged="Search_Changed"/>
        </DockPanel>

        <TextBlock x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   FontSize="13" Foreground="{StaticResource Sub}"/>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,10,-6,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Cards" Margin="0,0,0,4"/>
        </ScrollViewer>

        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"
                Background="{StaticResource Fg}" CornerRadius="12" Padding="12,4" Opacity="0" IsHitTestVisible="False">
            <TextBlock Text="Copied" Foreground="#FF0B0B0C" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
