<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyNotch.Pages.FocusPage">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Noise picker -->
    <Button x:Name="NoiseBtn" Classes="text" HorizontalAlignment="Center" Click="Noise_Click">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Noise: " FontSize="14" Foreground="{StaticResource Sub}"/>
        <TextBlock x:Name="NoiseText" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Fg}"/>
        <TextBlock Text="&#xE5CF;" Classes="icon" FontSize="16" Margin="4,1,0,0" Foreground="{StaticResource Fg}"/>
      </StackPanel>
    </Button>

    <!-- Middle: minutes picker when idle, countdown when running -->
    <Grid Grid.Row="1" VerticalAlignment="Center">
      <Grid x:Name="Picker">
        <Button Classes="icon" HorizontalAlignment="Left" Margin="60,0,0,0" Width="40" Height="40" FontSize="20"
                Content="&#xE15B;" ToolTip.Tip="5 minutes less" Click="Minus_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock x:Name="Minutes" FontFamily="{StaticResource Display}" FontSize="72" FontWeight="Light" Margin="0,-12,0,-12"/>
          <TextBlock Text="min" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Sub}"
                     VerticalAlignment="Bottom" Margin="10,0,0,10"/>
        </StackPanel>
        <Button Classes="icon" HorizontalAlignment="Right" Margin="0,0,60,0" Width="40" Height="40" FontSize="20"
                Content="&#xE145;" ToolTip.Tip="5 minutes more" Click="Plus_Click"/>
      </Grid>
      <StackPanel x:Name="Running" HorizontalAlignment="Center" IsVisible="False">
        <TextBlock x:Name="Phase" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Focus}"/>
        <TextBlock x:Name="Countdown" FontFamily="{StaticResource Display}" FontSize="64" FontWeight="Light"
                   HorizontalAlignment="Center" Margin="0,-8,0,-10"/>
      </StackPanel>
    </Grid>

    <!-- Bottom row -->
    <Grid Grid.Row="2">
      <Button Classes="icon" HorizontalAlignment="Left" Content="&#xE8B8;" ToolTip.Tip="Settings" Click="Settings_Click"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="PomodoroBtn" Classes="text" Content="Pomodoro" ToolTip.Tip="Focus, then a break, repeating" Click="Pomodoro_Click"/>
        <Button x:Name="ZenBtn" Classes="text" Content="Zen" Margin="4,0,0,0" ToolTip.Tip="One focus session, no breaks" Click="Zen_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="StopBtn" Classes="icon" Width="40" Height="40" FontSize="20" Content="&#xE047;"
                ToolTip.Tip="Stop" Margin="0,0,4,0" Click="Stop_Click"/>
        <Button x:Name="PlayBtn" Classes="icon" Width="44" Height="44" FontSize="30" CornerRadius="22" Content="&#xE037;" Click="Play_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
