<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:EasyNotch.Controls"
             x:Class="EasyNotch.Pages.MediaPage">
  <Grid>
    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="&#xE405;" Classes="icon" FontSize="32" Foreground="{StaticResource Faint}"/>
      <TextBlock Text="Nothing's playing" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <TextBlock Text="Play music or a video in any app and it'll show up here." FontSize="13"
                 Foreground="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>

    <Grid x:Name="Body" VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource FieldBg}" ClipToBounds="True">
          <Grid>
            <TextBlock Classes="icon" FontSize="26" Foreground="{StaticResource Faint}" Text="&#xE405;"/>
            <Border x:Name="ArtBox" CornerRadius="12"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ArtistText" FontSize="14" Foreground="{StaticResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="44,*,48">
        <TextBlock x:Name="Pos" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
        <c:SeekBar x:Name="Seek" Grid.Column="1" Margin="4,0"/>
        <TextBlock x:Name="LeftText" Grid.Column="2" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Button x:Name="ShuffleBtn" Classes="icon" HorizontalAlignment="Left" Width="40" Height="40" FontSize="20"
                Content="&#xE043;" ToolTip.Tip="Shuffle" Click="Shuffle_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Classes="icon" Width="44" Height="44" FontSize="26" Content="&#xE045;" ToolTip.Tip="Previous" Click="Prev_Click"/>
          <Button x:Name="PlayBtn" Classes="icon" Width="52" Height="52" FontSize="34" Margin="18,0" CornerRadius="26" Content="&#xE037;" Click="Play_Click"/>
          <Button Classes="icon" Width="44" Height="44" FontSize="26" Content="&#xE044;" ToolTip.Tip="Next" Click="Next_Click"/>
        </StackPanel>
        <Button x:Name="RepeatBtn" Classes="icon" HorizontalAlignment="Right" Width="40" Height="40" FontSize="20"
                Content="&#xE040;" ToolTip.Tip="Repeat" Click="Repeat_Click"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
