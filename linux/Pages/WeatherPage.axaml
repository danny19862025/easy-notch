<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:EasyNotch.Controls"
             x:Class="EasyNotch.Pages.WeatherPage">
  <Grid>
    <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
               Foreground="{StaticResource Sub}" Text="Loading weather…"/>

    <Grid x:Name="Body" IsVisible="False" RowDefinitions="Auto,*">
      <!-- Now (compact, so the page keeps the standard notch height) -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <c:WeatherIcon x:Name="NowIcon" Width="40" Height="40" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="NowTemp" FontFamily="{StaticResource Display}" FontSize="36" FontWeight="Light" Margin="0,-6,0,-6"/>
          <TextBlock x:Name="Unit" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="1,4,0,0" VerticalAlignment="Top"
                     Background="Transparent" Cursor="Hand" PointerReleased="Unit_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="Condition" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="Detail" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PlaceBtn" Classes="text" HorizontalContentAlignment="Left" Padding="6,1" Click="Place_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE55F;" Classes="icon" FontSize="13" Margin="0,0,4,0" Foreground="{StaticResource Fg}"/>
                <TextBlock x:Name="PlaceText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"
                           VerticalAlignment="Center" Foreground="{StaticResource Fg}"/>
                <TextBlock Text="&#xE5CF;" Classes="icon" FontSize="14" Margin="3,1,0,0" Foreground="{StaticResource Fg}"/>
              </StackPanel>
            </Button>
            <Button Classes="icon" Width="24" Height="24" CornerRadius="12" Content="&#xE5D5;" FontSize="14" ToolTip.Tip="Refresh" Click="Refresh_Click"/>
          </StackPanel>
          <TextBlock x:Name="Updated" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" Margin="0,1,6,0"/>
        </StackPanel>
      </Grid>

      <!-- Forecasts: next hours, then the next days -->
      <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
        <UniformGrid x:Name="Hourly" Rows="1"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,6,0,6"/>
        <UniformGrid x:Name="Daily" Rows="1"/>
      </StackPanel>
    </Grid>

    <!-- Place search -->
    <Border x:Name="Picker" Background="{StaticResource IslandBg}" IsVisible="False">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <Button DockPanel.Dock="Right" Classes="icon" Content="&#xE5CD;" FontSize="16" Margin="8,0,0,0"
                  ToolTip.Tip="Cancel" Click="PickerClose_Click"/>
          <TextBox x:Name="PlaceSearch" Classes="field" Watermark="Search for a city" TextChanged="PlaceSearch_Changed"
                   KeyDown="PlaceSearch_KeyDown"/>
        </DockPanel>
        <TextBlock x:Name="PickerHint" DockPanel.Dock="Top" FontSize="12" Foreground="{StaticResource Sub}" Margin="4,8,0,0"/>
        <StackPanel x:Name="Results" Margin="0,4,0,0"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
