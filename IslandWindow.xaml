<Window x:Class="EasyNotch.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easy Notch" Width="480" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Ui}" Foreground="{StaticResource Fg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- The window is a fixed transparent canvas; only the island inside it is visible and clickable. -->
    <Grid>
        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Width="150" Height="36" CornerRadius="18"
                Background="{StaticResource IslandBg}" BorderBrush="{StaticResource IslandEdge}" BorderThickness="1"
                ClipToBounds="True" MouseLeftButtonUp="Island_Click" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- ============ COMPACT ============ -->
                <Grid x:Name="Compact" Margin="8,0,12,0" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactGlyph" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Sub}" Text="&#xE823;"/>
                        <Border x:Name="CompactArtBox" CornerRadius="6" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArt" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- Right-hand indicator: equalizer while music plays, else a short label -->
                    <StackPanel x:Name="Eq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Visibility="Collapsed">
                        <Rectangle x:Name="Eq1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.55"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="CompactRight" Grid.Column="2" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- ============ EXPANDED ============ -->
                <Grid x:Name="Expanded" Margin="14,10,14,14" Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="11"
                                ToolTip="Close (Esc)" Click="Collapse_Click"/>
                        <RadioButton x:Name="TabSettings" DockPanel.Dock="Right" Style="{StaticResource TabBtn}" GroupName="tabs"
                                     Content="&#xE713;" ToolTip="Settings" Tag="settings" Checked="Tab_Checked"/>
                        <StackPanel x:Name="Tabs" Orientation="Horizontal"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,12,0,0">

                        <!-- Now Playing -->
                        <Grid x:Name="PanelMedia" Visibility="Collapsed">
                            <TextBlock x:Name="MediaEmpty" Foreground="{StaticResource Sub}" FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Nothing's playing.&#10;Start music or a video in any app and it'll show here."/>
                            <Grid x:Name="MediaBody">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="96" Height="96" CornerRadius="14" Background="{StaticResource FieldBg}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource Faint}" Text="&#xE8D6;"/>
                                            <Border CornerRadius="14">
                                                <Border.Background>
                                                    <ImageBrush x:Name="MediaArt" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="MediaTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MediaArtist" FontSize="13" Foreground="{StaticResource Sub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="MediaApp" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MediaPos" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                    <Slider x:Name="MediaSeek" Grid.Column="1" Style="{StaticResource Seek}" Minimum="0" Margin="6,0"
                                            PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                                    <TextBlock x:Name="MediaDur" Grid.Column="2" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Style="{StaticResource IconBtn}" Width="44" Height="44" FontSize="18" Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
                                    <Button x:Name="PlayPause" Style="{StaticResource IconBtn}" Width="56" Height="56" FontSize="26" Margin="14,0" Content="&#xE768;" Click="PlayPause_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Width="44" Height="44" FontSize="18" Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Focus -->
                        <Grid x:Name="PanelFocus" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="FocusPhaseText" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FocusClock" FontFamily="{StaticResource Display}" FontSize="52" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="0,-2,0,0"/>
                            </StackPanel>
                            <ProgressBar x:Name="FocusBar" Grid.Row="1" Height="4" Margin="40,4,40,0" Maximum="1"
                                         Background="{StaticResource Line}" Foreground="{StaticResource Focus}" BorderThickness="0"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button x:Name="FocusStart" Style="{StaticResource PillBtn}" MinWidth="96" Click="FocusStart_Click"/>
                                <Button x:Name="FocusBreak" Style="{StaticResource PillBtn}" Margin="8,0,0,0" Content="Break" Click="FocusBreak_Click"/>
                                <Button x:Name="FocusStop" Style="{StaticResource PillBtn}" Margin="8,0,0,0" Content="Stop" Click="FocusStop_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Focus" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Width="40"/>
                                        <Button Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10" Content="&#xE738;" Click="FocusMinus_Click"/>
                                        <TextBlock x:Name="FocusMinutes" FontSize="12" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10" Content="&#xE710;" Click="FocusPlus_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Break" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center" Width="40"/>
                                        <Button Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10" Content="&#xE738;" Click="BreakMinus_Click"/>
                                        <TextBlock x:Name="BreakMinutes" FontSize="12" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10" Content="&#xE710;" Click="BreakPlus_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="Sound while focusing" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource FieldBg}" CornerRadius="13" Padding="2">
                                        <StackPanel x:Name="NoiseChoices" Orientation="Horizontal"/>
                                    </Border>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Clipboard -->
                        <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Padding="12,6" Margin="8,0,0,0"
                                        Content="Clear" ToolTip="Remove everything except pinned items" Click="ClipClear_Click"/>
                                <TextBox x:Name="ClipSearch" Style="{StaticResource Field}" Tag="Search what you've copied" TextChanged="ClipSearch_Changed"/>
                            </DockPanel>
                            <TextBlock x:Name="ClipEmpty" Grid.Row="1" Foreground="{StaticResource Sub}" FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Copy some text or an image and it'll be kept here.&#10;Click an item to copy it again."/>
                            <ListBox x:Name="ClipList" Grid.Row="1" Margin="-10,8,-6,0" Style="{StaticResource Rows}"
                                     PreviewMouseLeftButtonUp="ClipList_Click">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Image Source="{Binding Thumb}" MaxHeight="64" HorizontalAlignment="Left" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button x:Name="pin" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="12"
                                                        Content="&#xE718;" ToolTip="Pin" Foreground="{StaticResource Faint}" Click="ClipPin_Click"/>
                                                <Button Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="11" Foreground="{StaticResource Faint}"
                                                        Content="&#xE74D;" ToolTip="Remove" Click="ClipRemove_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                <Setter TargetName="pin" Property="Content" Value="&#xE840;"/>
                                                <Setter TargetName="pin" Property="Foreground" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="pin" Property="ToolTip" Value="Unpin"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" TargetName="pin"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="ClipToast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Background="{StaticResource Accent}" CornerRadius="12" Padding="12,4" Opacity="0" IsHitTestVisible="False">
                                <TextBlock Text="Copied" Foreground="#FF0B0B0C" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Notes -->
                        <Grid x:Name="PanelNotes" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="NotesBox" Style="{StaticResource Field}" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     FontSize="14" Padding="12,10" Tag="Jot something down. It saves as you type."
                                     TextChanged="Notes_Changed"/>
                            <TextBlock x:Name="NotesStatus" Grid.Row="1" FontSize="11" Foreground="{StaticResource Faint}" Margin="4,6,0,0"/>
                        </Grid>

                        <!-- Clock -->
                        <Grid x:Name="PanelClock" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ClockBig" FontFamily="{StaticResource Display}" FontSize="40" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="ClockDate" FontSize="13" Foreground="{StaticResource Sub}"/>
                            </StackPanel>
                            <ListBox x:Name="CityList" Grid.Row="1" Margin="-10,10,-6,0" Style="{StaticResource Rows}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Offset}" FontSize="11" Foreground="{StaticResource Faint}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular" Margin="8,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="26" Height="26" FontSize="10"
                                                    Foreground="{StaticResource Faint}" Content="&#xE711;" ToolTip="Remove" Click="CityRemove_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <TextBox x:Name="CitySearch" Style="{StaticResource Field}" Tag="Add a place: type a city or time zone" TextChanged="CitySearch_Changed"/>
                            </Grid>
                            <!-- Suggestions float above the search box -->
                            <Border x:Name="CitySuggestBox" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,40"
                                    Background="{StaticResource FieldBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Visibility="Collapsed">
                                <ListBox x:Name="CitySuggest" Style="{StaticResource Rows}" MaxHeight="150" PreviewMouseLeftButtonUp="CitySuggest_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- Volume mixer (rows are built in code from the live audio sessions) -->
                        <ScrollViewer x:Name="PanelMixer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MixerRows" Margin="0,0,8,0"/>
                        </ScrollViewer>

                        <!-- Settings -->
                        <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Widgets" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,6"/>
                                <StackPanel x:Name="WidgetSettings"/>
                                <TextBlock Text="General" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,14,0,8"/>
                                <CheckBox x:Name="StartupToggle" Content="Start with Windows" Margin="0,0,0,10" Click="Startup_Click"/>
                                <CheckBox x:Name="TuckToggle" Content="Tuck away over full-screen apps" Margin="0,0,0,14" Click="Tuck_Click"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PillBtn}" Content="Open data folder" Click="DataFolder_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Quit Easy Notch" Margin="8,0,0,0" Click="Quit_Click"/>
                                </StackPanel>
                                <TextBlock Text="Everything Easy Notch keeps (notes, clipboard, settings) stays in that folder on this PC."
                                           FontSize="11" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
