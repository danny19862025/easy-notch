<Window x:Class="EasyNotch.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:EasyNotch.Controls"
        Title="Easy Notch" Width="700" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Ui}" Foreground="{StaticResource Fg}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The window is a fixed transparent canvas; only the notch is visible and clickable. -->
    <Grid>
        <c:NotchBorder x:Name="Notch" HorizontalAlignment="Center" VerticalAlignment="Top"
                       BodyWidth="170" BodyHeight="32" BottomRadius="16"
                       Fill="{StaticResource IslandBg}" Stroke="{StaticResource IslandEdge}"
                       MouseLeftButtonUp="Notch_Click" MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave">
            <c:NotchBorder.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
            </c:NotchBorder.Effect>
            <Grid>
                <!-- ============ COMPACT ============ -->
                <Grid x:Name="Compact" Margin="10,0,14,0" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactGlyph" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Sub}"/>
                        <Border x:Name="CompactArtBox" CornerRadius="5" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArt" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CompactText" Grid.Column="1" Margin="8,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="Eq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="13" Visibility="Collapsed">
                        <Rectangle x:Name="Eq1" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq2" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" Margin="0,0,2,0" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="Eq3" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.55"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="CompactRight" Grid.Column="2" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- ============ EXPANDED ============ -->
                <Grid x:Name="Expanded" Visibility="Collapsed" Opacity="0">
                    <!-- Grab handle: click to close -->
                    <Border x:Name="Handle" Width="120" Height="7" CornerRadius="3.5" BorderThickness="1" BorderBrush="{StaticResource Faint}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Background="Transparent" Cursor="Hand"
                            ToolTip="Close (Esc)" MouseLeftButtonUp="Handle_Click"/>
                    <ContentControl x:Name="PageHost" Margin="30,26,48,18" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageSlide"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <StackPanel x:Name="Dots" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>
                </Grid>
            </Grid>
        </c:NotchBorder>
    </Grid>
</Window>
